 <div id="box" class="jxgbox short-graph" <%- graphOpts %> ></div>

 <script>
    const myBoard = JXG.JSXGraph.initBoard(
        'box', {
        boundingbox: [-20, 10, 20, -10],
        //axis: true,
        showInfoBox: false,
        showNavigation: false,
    });
    const highlightColor = 'powderBlue' //'lightGreen'

    const mkRectangleIn = (boardName, [x, y], l, a, highlightedSection, withAsmile = false) => {
        //Rectangle
        boardName.create('polygon', [[x, y], [x + l, y], [x + l, y - a], [x, y - a]], {
            borders: {strokeColor: 'black', strokeWidth: 2},
            fillOpacity: 0,
            vertices: {fillOpacity: 0, strokeWidth: 0},
        })
        //Highlighted Side
        const pnts = highlightedSection === 'left'
            ? [[x, y], [x, y - a]]
            : [[x + l, y - a], [x, y - a]]
        boardName.create('segment', pnts, {strokeColor: highlightColor})
        //Content
        if (withAsmile) {
            boardName.create('point', [x + (l / 2), y - (a / 2)], {
                fillOpacity: 0,
                label: {offset: [-8, 50]},
                name: '😎',
                strokeWidth: 0,
                withLabel: true
            })
        }
    }
    const mkArrowIn = (boardName, pnts) => {
        boardName.create('segment', pnts, {
            lastArrow: {type: 2, size: 8},
            strokeColor: 'black',
            strokeWidth: 2
        })
    }

    //Opción 1
    mkRectangleIn(myBoard, [-15, 5], 12, 12, 'left')
    mkRectangleIn(myBoard, [-7, 0], 2, 3, 'left', true)
    mkArrowIn(myBoard, [[-8, -1.5], [-14, -1]])

    //Opción 2
    mkRectangleIn(myBoard, [0, 5], 12, 12, 'bottom')
    mkRectangleIn(myBoard, [5, 3], 2, 3, 'bottom', true)
    mkArrowIn(myBoard, [[6, -1], [6, -6]])
</script>