<script>
    //Constants
    const greenHex = '#729170';
    const orangeHex = '#DA8359';
    const shortOpts = {
        boundingbox: [-20, 10, 20, -10],
        showInfoBox: false,
        showNavigation: false,
    };
    //Helpers
    //TODO Refactor as: createNumLine(), addDots([greenDots], [orangeDots]), addAbsVal([nums]), addOperationArrow(a, b) which draws an arrow from a to a+b
    const createNumLine = (boardName, orangeDots = [], greenDots = [], includeAbsVal = false, includeOpArrow = 0) => {
        //Create line with arrows
        boardName.create('segment', [[-19, 0], [19, 0]], {
            firstArrow: true,
            lastArrow: true,
            strokeColor: 'black',
        });

        //Chop up the number line
        let maxNum;
        if (orangeDots.length > 0 || greenDots.length > 0) {
            maxNum = Math.max(
                ...orangeDots.map(x => Math.abs(x)),
                ...greenDots.map(x => Math.abs(x)),
                3
            );
        } else {
            maxNum = 5;
        }
        const pieceLength = 20/(maxNum + 1);
        const maxCoord = -20 + pieceLength;

        //Populate number line
        let numName = -maxNum;
        for(let i = maxCoord; i < 20; i+= pieceLength) {
            let numColor = 'black';
            //Check if number needs to be written in a highlight color
            if (orangeDots.includes(numName) || greenDots.includes(numName)) {
                numColor = orangeDots.includes(numName) ? orangeHex : greenHex;
                boardName.create('point', [i, 0], {
                    fillColor: numColor,
                    strokeColor: 'black',
                    strokeWidth: 1.5,
                    withLabel: false
                });
            }
            //Create number tick in number line
            boardName.create('segment', [[i, 0.5], [i, -0.5]], {
                label: {offset: [numName < 0 ? -6 : -4, 30], color: numColor, fontSize: 16},
                name: numName.toString(),
                strokeColor: 'black',
                strokeWidth: 1,
                withLabel: true
            });
            numName++;
        }

        if (includeAbsVal) {
            boardName.create('segment', [[0, 2], [orangeDots[1]*pieceLength, 2]], {
                firstArrow: {size: 8, type: 2},
                label: {color: orangeHex, fontSize: 16, offset: [0, 70]},
                lastArrow:  {size: 8, type: 2},
                name: `|${orangeDots[1]}|`,
                strokeColor: orangeHex,
                withLabel: true,
            })
        }
        if (includeOpArrow != 0) {
            const name = includeOpArrow > 0 ? `+${includeOpArrow}` : includeOpArrow.toString()
            boardName.create('segment', [[orangeDots[0]*pieceLength, 2], [greenDots[0]*pieceLength, 2]], {
                label: {color: greenHex, fontSize: 16, offset: [0, 70]},
                lastArrow: {size: 8, type: 2},
                name,
                strokeColor: greenHex,
                withLabel: true,
            })
        }
    };
    const createNumlessLine = (boardName, nums = [], includeAbsVal = true) => {
        //Create line with arrows
        boardName.create('segment', [[-19, 0], [19, 0]], {
            firstArrow: true,
            lastArrow: true,
            strokeColor: 'black',
        });
        //Populate number line with ticks (and label 0 and n's in [nums])
        let numName = -3;
        for (let i = -15; i < 20; i += 5) {
            boardName.create('segment', [[i, 0.5], [i, -0.5]], {
                label: { offset: [-4, 30], color: orangeHex, fontSize: 16 },
                name: numName === 0 ? '0'
                : nums.includes(numName) && numName > 0 ? 'n'
                : nums.includes(numName) && numName < 0 ? '-n'
                : '',
                strokeColor: 'black',
                strokeWidth: 1,
                withLabel: numName === 0 || nums.includes(numName)
            });
            numName++;
        }
        //Draw the abs val segment for each n in [nums]
        nums.forEach(n => {
            boardName.create('segment', [[0, 2], [n * 5, 2]], {
            firstArrow: { size: 8, type: 2 },
            label: { color: orangeHex, fontSize: 16, offset: [0, 70] },
            lastArrow: { size: 8, type: 2 },
            name: `|n|`,
            strokeColor: orangeHex,
            withLabel: true,
        })
        })
    }
    const createAbsValueLine = (boardName, n) => {
        createNumLine(boardName, [0, n], [], true);
    }
    const createOperationLine = (boardName, a, b) => {
        const nums = [a, a+b];
        const min = Math.min(...nums);
        const max = Math.max(...nums);
        createNumLine(boardName, [a], [a+b], false, b);
    }

    //Def de la regla de comparacion
    const rectaNumBoard = JXG.JSXGraph.initBoard('recta-num', shortOpts);
    createNumLine(rectaNumBoard);

    //Ejemplo de como usar la regla de la comparacion
    const boardEG1 = JXG.JSXGraph.initBoard('recta-eg1', shortOpts);
    createNumLine(boardEG1, [1], [3]);
    const boardEG2 = JXG.JSXGraph.initBoard('recta-eg2', shortOpts);
    createNumLine(boardEG2, [-3], [1]);

    //Def de numeros positivos/negativos
    const positiveBoard = JXG.JSXGraph.initBoard('recta-num-pos', shortOpts);
    createNumLine(positiveBoard, [1, 2, 3], [0]);
    const negativeBoard = JXG.JSXGraph.initBoard('recta-num-neg', shortOpts);
    createNumLine(negativeBoard, [-1, -2, -3], [0]);

    //Def de valor absoluto
    const valorAbsBoard = JXG.JSXGraph.initBoard('valor-abs-recta', shortOpts);
    createNumlessLine(valorAbsBoard, [3]);

    //Ejemplo 1 de como encontrar el valor absoluto
    const valorAbsEG1 = JXG.JSXGraph.initBoard('valor-abs-recta-eg1', shortOpts);
    createAbsValueLine(valorAbsEG1, 4);

    //Ejemplo 2 de como encontrar el valor absoluto
    const valorAbsEG2 = JXG.JSXGraph.initBoard('valor-abs-recta-eg2', shortOpts);
    createAbsValueLine(valorAbsEG2, -2);

    //Ejemplo 3 de como encontrar el valor absoluto
    const valorAbsEG3 = JXG.JSXGraph.initBoard('valor-abs-recta-eg3', shortOpts);
    createNumLine(valorAbsEG3, [0]);

    //Def de nums opuestos
    const opuestoDefBoard = JXG.JSXGraph.initBoard('opuesto-n', shortOpts);
    createNumlessLine(opuestoDefBoard, [3, -3]);

    //Ejemplo 1 de nums opuestos
    const opuestoEG1a = JXG.JSXGraph.initBoard('opuesto-eg1a', shortOpts);
    createAbsValueLine(opuestoEG1a, 6);
    const opuestoEG1b = JXG.JSXGraph.initBoard('opuesto-eg1b', shortOpts);
    createAbsValueLine(opuestoEG1b, -6);

    //Ejemplo 2 de nums opuestos
    const opuestoEG2a = JXG.JSXGraph.initBoard('opuesto-eg2a', shortOpts);
    createAbsValueLine(opuestoEG2a, -8);
    const opuestoEG2b = JXG.JSXGraph.initBoard('opuesto-eg2b', shortOpts);
    createAbsValueLine(opuestoEG2b, 8);

    //Ejemplo 1 de suma de opuestos
    const sumaEG1a = JXG.JSXGraph.initBoard('suma-opuestos-eg1a', shortOpts);
    createNumLine(sumaEG1a, [-5]);
    const sumaEG1b = JXG.JSXGraph.initBoard('suma-opuestos-eg1b', shortOpts);
    createOperationLine(sumaEG1b , -5, 5);

    //Ejemplo 2 de suma de opuestos
    const sumaEG2a = JXG.JSXGraph.initBoard('suma-opuestos-eg2a', shortOpts);
    createNumLine(sumaEG2a, [7]);
    const sumaEG2b = JXG.JSXGraph.initBoard('suma-opuestos-eg2b', shortOpts);
    createOperationLine(sumaEG2b , 7, -7);
</script>