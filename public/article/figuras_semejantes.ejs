<!-- ejercicio de verificar figuras semejantes-->
<div class='ejercicio'><!-- id 1 -->
    <p class='ejercicio-header'> Ejercicio. </p>
    <p><b>Verifica que estos dos triángulos son semejantes.</b></p>
    <div id='ejercicioBox2' class='jxgbox short-graph' <%- graphOpts %> ></div>
    <p class='full-of-answers hidden'> Para verificar... </p>

    <button class='see-answer-btn' onclick='showAnswers(1)'>Ver la respuesta</button>
</div>


<script>
    //Constantes
    const greenHex = '#729170';
    const orangeHex = '#DA8359';
    const pointName = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ'.split('');
    const defBoardOpts = {
        boundingbox: [-20, 10, 20, -10],
        showInfoBox: false,
        showNavigation: false
    };

    //Definicion
    const defBoard = JXG.JSXGraph.initBoard('definicionBox', defBoardOpts);
    const polygonOpts = {borders: {highlight: false, strokeColor: 'black', strokeWidth: 2}, highlight: false, vertices: {fillOpacity: 0, highlight: false, strokeWidth: 0}};
    const smallRectCoords = [[-15, 2], [-15, -2], [-7, -2], [-7, 2]];
    const smallRect = defBoard.create('polygon', smallRectCoords, {...polygonOpts, fillColor: greenHex});
    smallRectCoords.forEach((pnt, i) => {
        defBoard.create('point', pnt, {fillOpacity: 0, highlight: false, label: {fontSize: 16, offset: [i < 2? -15 : 5, 50]}, name: pointName[i], strokeWidth: 0, withLabel: true})
    });
    const bigRectCoords = [[0, 4], [0, -4], [16, -4], [16, 4]];
    const bigRect = defBoard.create('polygon', bigRectCoords, {...polygonOpts, fillColor: orangeHex});
    bigRectCoords.forEach((pnt, i) => {
        defBoard.create('point', pnt, {fillOpacity: 0, highlight: false, label: {fontSize: 16, offset: [i < 2? -15 : 5, 50]}, name: pointName[i+4], strokeWidth: 0, withLabel: true})
    });

    //Ejemplo 1
    const eg1box1 = JXG.JSXGraph.initBoard('star-box', defBoardOpts);
    const mkStarPolygon = (boardName, centerCoord, l) => {
        const s = l/2;
        const theta_l = 2 * Math.PI / 5;
        const vertices = [];
        const getCoords = (theta, r) => [centerCoord[0] + r * Math.cos(theta), centerCoord[1] + r * Math.sin(theta)];
        for(let i = 0; i < 2 * Math.PI; i += theta_l) {
            vertices.push(getCoords(i, l)); //Convex v-point
            vertices.push(getCoords(i + (theta_l / 2), s)); //Concave v-point
        }
        boardName.create('polygon', vertices, {
            borders: {strokeColor: centerCoord[0] < 0 ? greenHex : orangeHex, strokeWidth: 2},
            fillColor: centerCoord[0] < 0 ? greenHex : orangeHex,
            fillOpacity: 0.25,
            vertices: {visible: false}
        });
    };
    mkStarPolygon(eg1box1, [-10, 0], 8);
    mkStarPolygon(eg1box1, [10, 0], 5);

    //Ejemplo 2
    const eg1box2 = JXG.JSXGraph.initBoard('triangles-box', defBoardOpts);
    eg1box2.create('polygon', [[-15, 6], [-15, -5], [-5, -5]], {
        borders: {strokeColor: greenHex, strokeWidth: 2},
        fillColor: greenHex,
        fillOpacity: 0.25,
        vertices: {visible: false}
    });
    eg1box2.create('polygon', [[13, -5], [7, 6], [1, -5]], {
        borders: {strokeColor: orangeHex, strokeWidth: 2},
        fillColor: orangeHex,
        fillOpacity: 0.25,
        vertices: {visible: false}
    });

    const ejercicio1box1 = JXG.JSXGraph.initBoard('ejercicioBox1', defBoardOpts);
    const ejercicio1box2 = JXG.JSXGraph.initBoard('ejercicioBox2', defBoardOpts);
</script>