<script>
    //Constantes
    //JXG.Options.text.useKatex = true;
    const greenHex = '#729170';
    const orangeHex = '#DA8359';
    const pointName = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ'.split('');
    const defBoardOpts = {
        boundingbox: [-20, 10, 20, -10],
        showInfoBox: false,
        showNavigation: false
    };
    const pointOpts = (fillColor) => ({
        fillColor,
        fixed: true,
        highlight: false,
        strokeWidth: 0,
        withLabel: false
    })
    const polygonOpts = (fillColor, strokeColor = 'black') => ({
        borders: {highlight: false, strokeColor, strokeWidth: 2},
        fillColor,
        fillOpacity: 0.25,
        fixed: true,
        highlight: false,
        vertices: {visible: false}
    })
    const midPoint = (p1, p2) => {
        const x = (p2[0] + p1[0]) / 2
        const y = (p2[1] + p1[1]) / 2
        return [x, y]
    }
    const mkPolygonPair = (myBoard, verticesA, verticesB, verticesAoffset = null, verticesBoffset = null, lengthsA = [], lengthsB = [], lengthAoffset = [], lengthBoffset = []) => {

        //Plot vertices
        if (verticesAoffset === null) {
            verticesA.forEach((v1, i) => {
                //Vertices for fig A
                myBoard.create('point', v1, pointOpts(greenHex));
                //Vertices for fig B
                myBoard.create('point', verticesB[i], pointOpts(orangeHex));
            });
        } else {
            verticesA.forEach((v1, i) => {
                //Vertices' names for fig A
                myBoard.create('point', v1, {
                    ...pointOpts(greenHex),
                    label: {color: greenHex, fontSize: 16, offset: verticesAoffset(i)},
                    name: pointName[i],
                    withLabel: true
                });
                //Vertices' names for fig B
                const p1 = verticesB[i];
                myBoard.create('point', p1, {
                    ...pointOpts(orangeHex),
                    label: {color: orangeHex, fontSize: 16, offset: verticesBoffset(i)},
                    name: pointName[i+4],
                    withLabel: true
                });
            });
        }

        //Label side lengths
        const n = verticesA.length;
        lengthsA.forEach((l, i) => {
            //Side lengths for fig A
            let v1 = verticesA[i];
            let v2 = verticesA[(i+1)%n];
            myBoard.create('point', midPoint(v1, v2), {
                fillOpacity: 0,
                label: {fontSize: 16, offset: lengthAoffset[i]},
                //label: {position: 'bottom'},  y u no work?? =(((
                name: l.toString(),
                strokeWidth: 0,
                useKaTeX: true,
                withLabel: true,
            });
            //Side lengths for fig B
            v1 = verticesB[i];
            v2 = verticesB[(i+1)%n];
            myBoard.create('point', midPoint(v1, v2), {
                fillOpacity: 0,
                label: {fontSize: 16, offset: lengthBoffset[i]},
                name: lengthsB[i].toString(),
                strokeWidth: 0,
                useKaTeX: true,
                withLabel: true,
            });
        });

        //Draw polygons
        myBoard.create('polygon', verticesA, polygonOpts(greenHex, greenHex));
        myBoard.create('polygon', verticesB, polygonOpts(orangeHex, orangeHex));
    }

    //Definicion
    const defBoard = JXG.JSXGraph.initBoard('definicionBox', defBoardOpts);
    let verticesA = [[-15, 2], [-15, -2], [-7, -2], [-7, 2]];
    let verticesAoffset = i => [i < 2? -15 : 5, 50];
    let verticesB = [[0, 4], [0, -4], [16, -4], [16, 4]];
    mkPolygonPair(defBoard, verticesA, verticesB, verticesAoffset, verticesAoffset);

    //Ejemplo 1
    const mkStarPolygon = (boardName, centerCoord, l) => {
        const s = l/2;
        const theta_l = 2 * Math.PI / 5;
        const vertices = [];
        const getCoords = (theta, r) => [centerCoord[0] + r * Math.cos(theta), centerCoord[1] + r * Math.sin(theta)];
        const myColor = centerCoord[0] < 0 ? greenHex : orangeHex
        for(let i = 0; i < 2 * Math.PI; i += theta_l) {
            vertices.push(getCoords(i, l)); //Convex v-point
            vertices.push(getCoords(i + (theta_l / 2), s)); //Concave v-point
        }
        vertices.forEach(v => {
            boardName.create('point', v, pointOpts(myColor));
        });
        boardName.create('polygon', vertices, {
            borders: {strokeColor: myColor, strokeWidth: 2},
            fillColor: myColor,
            fillOpacity: 0.25,
            vertices: {visible: false}
        });
    };
    const eg1box1 = JXG.JSXGraph.initBoard('star-box', defBoardOpts);
    mkStarPolygon(eg1box1, [-10, 0], 8);
    mkStarPolygon(eg1box1, [10, 0], 5);

    //Ejemplo 2
    const eg1box2 = JXG.JSXGraph.initBoard('triangles-box', defBoardOpts);
    mkPolygonPair(eg1box2, [[-15, 6], [-15, -5], [-5, -5]], [[13, -5], [7, 6], [1, -5]]);

    //Def de lados similares
    verticesA = [[-7, 5], [-13, 5], [-17, -5], [-3, -5]];
    verticesAoffset = i => i < 1 ? [0, 65] : i < 2 ? [-10, 65] : [0, 30];
    verticesB = [[12, 3], [7, 3], [4.5, -3], [14.5, -3]];
    const ladosSimilaresBox = JXG.JSXGraph.initBoard('lados-similares', defBoardOpts);
    mkPolygonPair(ladosSimilaresBox, verticesA, verticesB, verticesAoffset, verticesAoffset);

    //Ejemplo 3 (dos rectángulos)
    const eg3board = JXG.JSXGraph.initBoard('eg3box', defBoardOpts);
    verticesA = [[-15, 2], [-15, -2], [-7, -2], [-7, 2]];
    verticesAoffset = i => [i < 2? -15 : 5, 50];
    let lengthsA = [3, 5];
    let lengthAoffset = [[-15, 47], [-10, 37]];
    verticesB = [[0, 4], [0, -4], [16, -4], [16, 4]];
    let lengthsB = [6, 10];
    let lengthBoffset = [[-15, 50], [-20, 40]];
    mkPolygonPair(eg3board, verticesA, verticesB, verticesAoffset, verticesAoffset, lengthsA, lengthsB, lengthAoffset, lengthBoffset);

    //Ejercicio 1 (dos triángulos)
    const ejercicio1board = JXG.JSXGraph.initBoard('ejercicioBox1', defBoardOpts);
    verticesA = [[-7, 5], [-13, 5], [-17, -5]];
    verticesAoffset = i => i < 1 ? [0, 65] : i < 2 ? [-10, 65] : [0, 30];
    lengthsA = [3, 7, 10];
    lengthAoffset = [[-10, 60], [-10, 60], [-10, 30]];
    verticesB = [[12, 3], [7, 3], [4.5, -3]];
    lengthsB = [1.5, 3.5, 4];
    lengthBoffset = [[-10, 60], [-25, 60], [-10, 30]];
    mkPolygonPair(ejercicio1board, verticesA, verticesB, verticesAoffset, verticesAoffset, lengthsA, lengthsB, lengthAoffset, lengthBoffset);

    //Ejercicio 2 (dos trapecios)
    const ejercicio2board = JXG.JSXGraph.initBoard('ejercicioBox2', defBoardOpts);
    verticesA = [[-7, 5], [-13, 5], [-17, -5], [-3, -5]];
    verticesAoffset = i => i < 1 ? [0, 65] : i < 2 ? [-10, 65] : [0, 30];
    lengthsA = [3, 7, 10, 7];
    lengthAoffset = [[-10, 60], [-10, 60], [-10, 30], [7, 55]];
    verticesB = [[12, 3], [7, 3], [4.5, -3], [14.5, -3]];
    lengthsB = [1.5, 3.5, 5, 3.5];
    lengthBoffset = [[-10, 60], [-25, 60], [-10, 30], [7, 55]];
    mkPolygonPair(ejercicio2board, verticesA, verticesB, verticesAoffset, verticesAoffset, lengthsA, lengthsB, lengthAoffset, lengthBoffset);
</script>