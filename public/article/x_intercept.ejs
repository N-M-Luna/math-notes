<script>
    const greenHex = '#729170';
    const orangeHex = '#DA8359';

    //Definition of linear equation
    const linearDefBoard = JXG.JSXGraph.initBoard( 'linearEqnDef', {
        boundingbox: [-5, 5, 5, -5],
        axis: true,
        showInfoBox: false,
        showNavigation: false,
    });
    const xIntCoords = [0, 1];
    const dX = 3;
    const dY = 2; //TODO make this interactive
    const pntCoord = [xIntCoords[0] + dX, xIntCoords[1] + dY];
    const lineGraph = linearDefBoard.create('line', [xIntCoords, pntCoord], {
        fixed: true,
        highlight: false,
        strokeColor: 'black'
    });
    const xInt = linearDefBoard.create('point', xIntCoords, {
        fillColor: greenHex,
        fixed: true,
        highlight: false,
        label: {color: greenHex, fontSize: 20, offset: [3, 75]},
        name: `${xIntCoords[1]}`,
        strokeColor: greenHex
    });
    const slopePntCoord = [xIntCoords[0] + dX, xIntCoords[1] + dY];
    const deltaX = linearDefBoard.create('segment', [xIntCoords, [slopePntCoord[0], xIntCoords[1]]], {
        fixed: true,
        highlight: false,
        label: {color: orangeHex, fontSize: 20, offset: [0, 30]},
        lastArrow: {anchorX: 'middle', type: 2, size: 8},
        name: `${dX}`,
        strokeColor: orangeHex,
        withLabel: true
    });
    const deltaY = linearDefBoard.create('segment', [[slopePntCoord[0], xIntCoords[1]], slopePntCoord], {
        fixed: true,
        highlight: false,
        label: {color: orangeHex, fontSize: 20, offset: [10, 40]},
        lastArrow: {type: 2, size: 8},
        name: `${dY}`,
        strokeColor: orangeHex,
        withLabel: true
    });
    const lineEqn = linearDefBoard.create('point', [1, -3.75], {
        fillOpacity: 0,
        fixed: true,
        highlight: false,
        label: {fontSize: 25},
        name: `y = <span class='orange-text'> &frac${dY}${dX}; </span> x + <span class='green-text'> ${xIntCoords[1]}</span>`,
        strokeWidth: 0,
        withLabel: true
    });

    //For example 1
    const boundingbox = [-1.5, 8, 8, -1.5];
    const makeLabels = boardName => {
        const labelOpts = {fixed: true, fontSize: 14, highlight: false}
        boardName.create('text', [2, 0.2, 'number of planks'], labelOpts)
        boardName.create('text', [-0.75, 3, 'number of nails'], {...labelOpts, rotate: 90})
    }
    const makeYint = boardName => {
        boardName.create('point', [0, 0], {
            fillColor: greenHex,
            fixed: true,
            highlight: false,
            strokeColor: greenHex,
            strokeWidth: 1.5,
            withLabel: false
        })
    }
    //1.0 Axes' labels
    const egLabelsBoard = JXG.JSXGraph.initBoard( 'egLabels', {
        boundingbox,
        axis: true,
        showInfoBox: false,
        showNavigation: false,
    });
    makeLabels(egLabelsBoard);
    //1.1 Y intercept
    const egYintBoard = JXG.JSXGraph.initBoard( 'egYint', {
        boundingbox,
        axis: true,
        showInfoBox: false,
        showNavigation: false,
    });
    makeLabels(egYintBoard);
    makeYint(egYintBoard);
    //1.2 Slope
    const egSlopeBoard = JXG.JSXGraph.initBoard( 'egSlope', {
        boundingbox,
        axis: true,
        showInfoBox: false,
        showNavigation: false,
    });
    makeLabels(egSlopeBoard);
    makeYint(egSlopeBoard);
    egSlopeBoard.create('segment', [[0, 0], [1, 0]], {
        fixed: true,
        highlight: false,
        label: {fonstSize: 16, offset: [-20, 30]},
        lastArrow: {type: 4},
        name: '<span class="orange-text">+ 1 plank</span>',
        strokeColor: orangeHex,
        withLabel: true
    });
    egSlopeBoard.create('segment', [[1, 0], [1, 3.9]], {
        fixed: true,
        highlight: false,
        label: {fonstSize: 16, offset: [10, 20], rotate: 90},
        lastArrow: {type: 4},
        name: '<span class="orange-text">+ 4 nails</span>',
        strokeColor: orangeHex,
        withLabel: true
    });
    egSlopeBoard.create('point', [1, 4], {
        fixed: true,
        fillColor: orangeHex,
        highlight: false,
        strokeColor: orangeHex,
        strokeWidth: 1,
        withLabel: false
    });
    egSlopeBoard.create('line', [[0, 0], [1, 4]], {
        dash: 2,
        fixed: true,
        highlight: false,
        strokeColor: 'black'
    });
    //1.3 Complete line
    const egLineBoard = JXG.JSXGraph.initBoard( 'egLine', {
        boundingbox,
        axis: true,
        showInfoBox: false,
        showNavigation: false,
    });
    makeLabels(egLineBoard);
    egLineBoard.create('line', [[0, 0], [1, 4]], {
        fixed: true,
        highlight: false,
        strokeColor: greenHex
    });
</script>