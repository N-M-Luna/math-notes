<!doctype html>
<html>

  <head>
    <meta charset='UTF-8'>
    <title>Math Notes</title>
    <link rel='stylesheet' href='myStyle.css'>
  </head>

  <body>
  <h1 class='en-content'>Math Notes</h1>
  <h1 class='es-content hidden'>Notas de Matemáticas</h1>
  <hr class='page-header'>

  <%- include(bttButtonPath) %>

  <%- include(langCntrlPath) %>

  <p class='intro en-content'>Here are some of my writings on math.</p>
  <p class='intro es-content hidden'>Aquí hay algunos de mis escritos de matemáticas.</p>

  <div class='en-content'>
    <div> <!--Section index 0-->
      <h2 class='section-header'>High School Algebra</h2>
      <p class='section-controls'>
        <button onclick='expandMathList(0)' class='section-cntrl-btn'><i class="fa-solid fa-plus"></i></button>
        <button onclick='collapseMathList(0)' class='section-cntrl-btn hidden'><i class="fa-solid fa-minus"></i></button>
      </p>
    </div>

    <p class='section-intro'>Sample writings</p>

    <div class='math-list hidden'>
      <p><a href='/article/slope_triangles'>Slope triangles</a></p>
      <p><a href='/article/x_intercept'>The x-intercept of a linear function</a></p>
    </div>
  </div>

  <div class='es-content'>
    <div> <!--Section index 1-->
      <h2 class='section-header'>Matemáticas de Séptimo Grado</h2>
      <p class='section-controls'>
        <button onclick='expandMathList(1)' class='section-cntrl-btn'><i class="fa-solid fa-plus"></i></button>
        <button onclick='collapseMathList(1)' class='section-cntrl-btn hidden'><i class="fa-solid fa-minus"></i></button>
      </p>
    </div>

    <p class='section-intro'>Notas de un curso de mate de séptimo grado</p>

    <div class='math-list hidden'>
      <%- mate7menu %>
    </div>
  </div>

  <div class='en-content'>
    <%- include(footerPath) %>
  </div>
  <div class='es-content hidden'>
    <%- include(pieDePaginaPath) %>
  </div>
  </body>

  <script src='index.js'></script>
  <script src='https://kit.fontawesome.com/5721503876.js' crossorigin='anonymous'></script>
  <script>
    function showLanguageBtns() {
      const langBtns = document.getElementById('language-btns');
      langBtns.classList.toggle('hidden');
    }

    function translatePage(langToSet) {
      //Find and hide all .en-content and .es-content
      const englishContent = document.getElementsByClassName('en-content');
      for(let i = 0; i < englishContent.length; i++) {
        englishContent[i].classList.add('hidden')
      }
      const contenidoEspanol = document.getElementsByClassName('es-content');
      for(let i = 0; i < contenidoEspanol.length; i++) {
        contenidoEspanol[i].classList.add('hidden')
      }

      //Find all elements with class `${langToSet}-content` and remove the hidden class
      const targetContent = document.getElementsByClassName(langToSet + '-content');
      for(let i = 0; i < targetContent.length; i++) {
        targetContent[i].classList.remove('hidden')
      }

      //Change active btns
      const langBtns = document.querySelectorAll('.language-controls button')
      langBtns[0].classList.remove('active')
      langBtns[1].classList.remove('active')
      document.getElementById(langToSet + '-btn').classList.add('active')

      //Close language controls
      const langCntrl = document.getElementById('language-btns');
      langCntrl.classList.add('hidden');
    }

    function expandMathList(indx) {
      //Expand math list with index indx
      const mathLists = document.getElementsByClassName('math-list')
      mathLists[indx].classList.remove('hidden');
      //Switch the '+' button with the '-' button
      const sectionCntrls = document.getElementsByClassName('section-controls')
      const plusBtn = sectionCntrls[indx].firstElementChild
      plusBtn.classList.add('hidden')
      const minusBtn = plusBtn.nextElementSibling
      minusBtn.classList.remove('hidden')
    }

    function collapseMathList(indx) {
      //Expand or collapse math list with index indx
      const mathLists = document.getElementsByClassName('math-list')
      mathLists[indx].classList.add('hidden')
      //Switch the '-' button with the '+' button
      const sectionCntrls = document.getElementsByClassName('section-controls')
      const plusBtn = sectionCntrls[indx].firstElementChild
      plusBtn.classList.remove('hidden')
      const minusBtn = plusBtn.nextElementSibling
      minusBtn.classList.add('hidden')
    }
  </script>

</html>