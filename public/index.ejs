  <script>
    function translatePage(langToSet) {
      //Find and hide all .en-content and .es-content
      const englishContent = document.getElementsByClassName('en-content');
      for(let i = 0; i < englishContent.length; i++) {
        englishContent[i].classList.add('hidden')
      }
      const contenidoEspanol = document.getElementsByClassName('es-content');
      for(let i = 0; i < contenidoEspanol.length; i++) {
        contenidoEspanol[i].classList.add('hidden')
      }

      //Find all elements with class `${langToSet}-content` and remove the hidden class
      const targetContent = document.getElementsByClassName(langToSet + '-content');
      for(let i = 0; i < targetContent.length; i++) {
        targetContent[i].classList.remove('hidden')
      }

      //Change html lang attribute.
      const htmlElem = document.getElementsByTagName('html')
      // htmlElem.setAttribute('lang', langToSet)

      //Change active btns
      const langBtns = document.querySelectorAll('.language-controls button')
      langBtns[0].classList.remove('active')
      langBtns[1].classList.remove('active')
      document.getElementById(langToSet + '-btn').classList.add('active')
    }
  </script>

